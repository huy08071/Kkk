<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_card_root"
    android:layout_width="290dp"
    android:layout_height="wrap_content"
    android:background="#E61E1E2E"
    android:elevation="10dp"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- =========================================================
         TOP HEADER: Draggable via MotionEvent + Minimize & Close
         ========================================================= -->
    <LinearLayout
        android:id="@+id/header_drag_bar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="6dp"
            android:text="⠿"
            android:textColor="#A6ADC8"
            android:textSize="16sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Game Assistant"
            android:textColor="#CDD6F4"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Minimize Button (collapses content view) -->
        <TextView
            android:id="@+id/btn_minimize"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="#313244"
            android:gravity="center"
            android:text="—"
            android:textColor="#CDD6F4"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Close Button (kills the service) -->
        <TextView
            android:id="@+id/btn_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="#313244"
            android:gravity="center"
            android:text="✕"
            android:textColor="#F38BA8"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- =========================================================
         COLLAPSIBLE CONTENT BODY (Tabs + Route / Upgrade Content)
         ========================================================= -->
    <LinearLayout
        android:id="@+id/collapsible_content_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- 2-TAB NAVIGATION BAR: "Hướng đi" & "Nâng cấp" -->
        <LinearLayout
            android:id="@+id/tab_bar_container"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="6dp"
            android:background="#181825"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/tab_route"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Hướng đi"
                android:textColor="#1E1E2E"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_upgrade"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Nâng cấp"
                android:textColor="#A6ADC8"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- =====================================================
             TAB 1: "Hướng đi" (Strategic Route: Early, Mid, Late)
             ===================================================== -->
        <LinearLayout
            android:id="@+id/view_tab_route"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phong cách chơi (Playstyle):"
                android:textColor="#A6ADC8"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_style_attack"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="⚔️ Tấn công"
                    android:textColor="#89B4FA"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btn_style_defense"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="🛡️ Phòng thủ"
                    android:textColor="#CDD6F4"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_style_speed"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="⚡ Cày cấp nhanh"
                    android:textColor="#CDD6F4"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btn_style_economy"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="💎 Tối ưu tài nguyên"
                    android:textColor="#CDD6F4"
                    android:textSize="11sp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="155dp"
                android:layout_marginTop="8dp"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Early Game -->
                    <LinearLayout
                        android:id="@+id/card_stage_early"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:background="#313244"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ĐẦU GAME (EARLY GAME)"
                            android:textColor="#89B4FA"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_early_route"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="#CDD6F4"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Mid Game -->
                    <LinearLayout
                        android:id="@+id/card_stage_mid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:background="#313244"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GIỮA GAME (MID GAME)"
                            android:textColor="#F9E2AF"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_mid_route"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="#CDD6F4"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Late Game -->
                    <LinearLayout
                        android:id="@+id/card_stage_late"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#313244"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CUỐI GAME (LATE GAME)"
                            android:textColor="#F38BA8"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_late_route"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="#CDD6F4"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- =====================================================
             TAB 2: "Nâng cấp" (Upgrade Priorities: Tier S, A, B)
             ===================================================== -->
        <ScrollView
            android:id="@+id/view_tab_upgrade"
            android:layout_width="match_parent"
            android:layout_height="225dp"
            android:layout_marginTop="8dp"
            android:scrollbars="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/upgrade_items_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

    </LinearLayout>

</LinearLayout>
